--
-- For more information on build.settings, see the Project Build Settings guide at:
-- https://docs.coronalabs.com/guide/distribution/buildSettings
--

settings =
{
	orientation =
	{
		-- Supported values for orientation:
		-- portrait, portraitUpsideDown, landscapeLeft, landscapeRight
		default = "landscapeRight",
		supported = { "landscapeRight", "landscapeLeft" },
	},

	--
	-- Plugins section
	--
	plugins =
	{
		-- spriteloop-kirjasto etsii zip-pluginia käynnistyessään. Ilman tätä riviä Simulator näyttää siitä varoituksen.
		["plugin.zip"] =
		{
			publisherId = "com.coronalabs",
		},
	},

	--
	-- Build section
	--
	build =
	{
		-- Keeps debug symbols in the build, so stack traces show real function names and line numbers.
		-- Read more at https://docs.coronalabs.com/guide/distribution/advancedSettings/index.html#build-control
		neverStripDebugInfo = true,
	},
}
